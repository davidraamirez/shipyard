{
  "name": "shipyard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
    "scripts": {
    "dev:web": "pnpm --filter @shipyard/web dev",
    "dev:api": "pnpm --filter @shipyard/api start:dev",
    "dev:worker": "pnpm --filter @shipyard/worker dev",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "pnpm build:packages && pnpm --filter @shipyard/api test:e2e",
    "lint": "pnpm -r lint"
  },
    "keywords": [],
    "author": "David Ramirez Palacios",
    "license": "ISC",
    "devEngines": {
      "packageManager": {
        "name": "pnpm",
        "version": "12.10.1",
        "onFail": "download"
      }
    },
    "packageManager": "pnpm@12.10.1",
    "type": "module"
}
